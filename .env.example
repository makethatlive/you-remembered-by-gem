# Database Configuration
# UPDATE THIS with your actual database connection string
# Examples below for different database providers

# Local PostgreSQL (Update 'password' with your actual PostgreSQL password)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/youremembered?schema=public"

# OR use one of these cloud options:

# Supabase (Get from: Project Settings > Database > Connection String)
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Railway (Get from: Your PostgreSQL service > Variables > DATABASE_URL)
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/railway"

# Neon (Get from: Dashboard > Connection String)
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]/[DATABASE]?sslmode=require"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Anthropic Claude AI Configuration
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY="your_claude_api_key_here"

# Application Configuration
NODE_ENV="development"
PORT=3001

# Session Secret (Generate a random string)
SESSION_SECRET="your_random_session_secret_here"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# API URL
API_URL="http://localhost:3001"

# Internal Function Secret (for server-to-server calls)
INTERNAL_FUNCTION_SECRET="your_internal_secret_here"
