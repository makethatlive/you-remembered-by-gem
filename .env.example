# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/youremembered?schema=public"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Application Configuration
NODE_ENV="development"
PORT=3000

# Email Configuration (e.g., using SendGrid, Mailgun, etc.)
EMAIL_SERVICE="sendgrid"
EMAIL_API_KEY="your_email_api_key"
EMAIL_FROM="noreply@youremembered.com"

# AI Configuration (OpenAI, Anthropic, etc.)
OPENAI_API_KEY="your_openai_api_key"

# Session Secret
SESSION_SECRET="your_random_session_secret_here"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# API URL
API_URL="http://localhost:3000"
